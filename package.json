{
  "name": "at-terminal",
  "displayName": "%atTerminal.displayName%",
  "description": "%atTerminal.description%",
  "version": "0.3.4",
  "publisher": "local",
  "icon": "media/at-terminal-icon.png",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:sshManager.servers",
    "onView:sshManager.sftpFiles"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sshManager",
          "title": "%atTerminal.viewsContainer.title%",
          "icon": "media/at-terminal-activity.svg"
        }
      ]
    },
    "views": {
      "sshManager": [
        {
          "id": "sshManager.servers",
          "name": "%atTerminal.view.servers.name%"
        },
        {
          "id": "sshManager.sftpFiles",
          "name": "%atTerminal.view.sftpFiles.name%",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "sshManager.addServer",
        "title": "%atTerminal.command.addServer.title%",
        "icon": "$(add)"
      },
      {
        "command": "sshManager.editServer",
        "title": "%atTerminal.command.editServer.title%",
        "icon": "$(edit)"
      },
      {
        "command": "sshManager.deleteServer",
        "title": "%atTerminal.command.deleteServer.title%",
        "icon": "$(trash)"
      },
      {
        "command": "sshManager.connect",
        "title": "%atTerminal.command.connect.title%"
      },
      {
        "command": "sshManager.disconnect",
        "title": "%atTerminal.command.disconnect.title%"
      },
      {
        "command": "sshManager.reconnect",
        "title": "%atTerminal.command.reconnect.title%"
      },
      {
        "command": "sshManager.copyHost",
        "title": "%atTerminal.command.copyHost.title%",
        "icon": "$(copy)"
      },
      {
        "command": "sshManager.refresh",
        "title": "%atTerminal.command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "sshManager.sftp.refresh",
        "title": "%atTerminal.command.sftp.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "sshManager.sftp.upload",
        "title": "%atTerminal.command.sftp.upload.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sshManager.sftp.download",
        "title": "%atTerminal.command.sftp.download.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "sshManager.sftp.delete",
        "title": "%atTerminal.command.sftp.delete.title%",
        "icon": "$(trash)"
      },
      {
        "command": "sshManager.sftp.rename",
        "title": "%atTerminal.command.sftp.rename.title%",
        "icon": "$(edit)"
      },
      {
        "command": "sshManager.sftp.newFile",
        "title": "%atTerminal.command.sftp.newFile.title%",
        "icon": "$(new-file)"
      },
      {
        "command": "sshManager.sftp.newFolder",
        "title": "%atTerminal.command.sftp.newFolder.title%",
        "icon": "$(new-folder)"
      },
      {
        "command": "sshManager.sftp.copyPath",
        "title": "%atTerminal.command.sftp.copyPath.title%",
        "icon": "$(copy)"
      },
      {
        "command": "sshManager.sftp.edit",
        "title": "%atTerminal.command.sftp.edit.title%",
        "icon": "$(edit)"
      },
      {
        "command": "sshManager.sftp.openPreview",
        "title": "%atTerminal.command.sftp.openPreview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "sshManager.sftp.cdToDirectory",
        "title": "%atTerminal.command.sftp.cdToDirectory.title%",
        "icon": "$(terminal)"
      },
      {
        "command": "sshManager.sftp.goToPath",
        "title": "%atTerminal.command.sftp.goToPath.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sshManager.sftp.goUp",
        "title": "%atTerminal.command.sftp.goUp.title%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sshManager.installMcpConfig",
        "title": "%atTerminal.command.installMcpConfig.title%"
      },
      {
        "command": "sshManager.uninstallAtSeriesMcpConfig",
        "title": "%atTerminal.command.uninstallAtSeriesMcpConfig.title%"
      },
      {
        "command": "sshManager.exportAssets",
        "title": "%atTerminal.command.exportAssets.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sshManager.importAssets",
        "title": "%atTerminal.command.importAssets.title%",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sshManager.addServer",
          "when": "view == sshManager.servers",
          "group": "navigation@1"
        },
        {
          "command": "sshManager.refresh",
          "when": "view == sshManager.servers",
          "group": "navigation@2"
        },
        {
          "command": "sshManager.exportAssets",
          "when": "view == sshManager.servers",
          "group": "navigation@3"
        },
        {
          "command": "sshManager.importAssets",
          "when": "view == sshManager.servers",
          "group": "navigation@4"
        },
        {
          "command": "sshManager.sftp.refresh",
          "when": "view == sshManager.sftpFiles",
          "group": "navigation@1"
        },
        {
          "command": "sshManager.sftp.upload",
          "when": "view == sshManager.sftpFiles",
          "group": "navigation@2"
        },
        {
          "command": "sshManager.sftp.goUp",
          "when": "view == sshManager.sftpFiles",
          "group": "navigation@3"
        },
        {
          "command": "sshManager.sftp.goToPath",
          "when": "view == sshManager.sftpFiles",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "sshManager.addServer",
          "when": "view == sshManager.servers && viewItem == group",
          "group": "management@1"
        },
        {
          "command": "sshManager.editServer",
          "when": "view == sshManager.servers && viewItem == server",
          "group": "management@1"
        },
        {
          "command": "sshManager.deleteServer",
          "when": "view == sshManager.servers && viewItem == server",
          "group": "management@2"
        },
        {
          "command": "sshManager.copyHost",
          "when": "view == sshManager.servers && viewItem == server",
          "group": "management@3"
        },
        {
          "command": "sshManager.sftp.refresh",
          "when": "view == sshManager.sftpFiles && viewItem == sftpDirectory",
          "group": "navigation@1"
        },
        {
          "command": "sshManager.sftp.upload",
          "when": "view == sshManager.sftpFiles && viewItem == sftpDirectory",
          "group": "transfer@1"
        },
        {
          "command": "sshManager.sftp.download",
          "when": "view == sshManager.sftpFiles && (viewItem == sftpDirectory || viewItem == sftpFile)",
          "group": "transfer@2"
        },
        {
          "command": "sshManager.sftp.edit",
          "when": "view == sshManager.sftpFiles && viewItem == sftpFile",
          "group": "open@1"
        },
        {
          "command": "sshManager.sftp.openPreview",
          "when": "view == sshManager.sftpFiles && viewItem == sftpFile",
          "group": "open@2"
        },
        {
          "command": "sshManager.sftp.cdToDirectory",
          "when": "view == sshManager.sftpFiles && viewItem == sftpDirectory",
          "group": "open@3"
        },
        {
          "command": "sshManager.sftp.newFile",
          "when": "view == sshManager.sftpFiles && (viewItem == sftpDirectory || viewItem == sftpFile)",
          "group": "management@1"
        },
        {
          "command": "sshManager.sftp.newFolder",
          "when": "view == sshManager.sftpFiles && viewItem == sftpDirectory",
          "group": "management@2"
        },
        {
          "command": "sshManager.sftp.rename",
          "when": "view == sshManager.sftpFiles && (viewItem == sftpDirectory || viewItem == sftpFile)",
          "group": "management@3"
        },
        {
          "command": "sshManager.sftp.delete",
          "when": "view == sshManager.sftpFiles && (viewItem == sftpDirectory || viewItem == sftpFile)",
          "group": "management@4"
        },
        {
          "command": "sshManager.sftp.copyPath",
          "when": "view == sshManager.sftpFiles && (viewItem == sftpDirectory || viewItem == sftpFile || viewItem == sftpDisconnectedDirectory || viewItem == sftpDisconnectedFile)",
          "group": "management@5"
        }
      ]
    },
    "configuration": {
      "title": "%atTerminal.configuration.title%",
      "properties": {
        "sshManager.terminalFontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8
        },
        "sshManager.terminalFontFamily": {
          "type": "string",
          "default": "Cascadia Code, Menlo, monospace"
        },
        "sshManager.scrollback": {
          "type": "number",
          "default": 10000,
          "minimum": 100
        },
        "sshManager.semanticHighlight": {
          "type": "boolean",
          "default": true,
          "description": "Enable frontend semantic highlighting for plain SSH terminal output that does not already contain ANSI colors."
        },
        "sshManager.idleDisconnectMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Disconnect idle SSH terminals after this many minutes. Set 0 to disable."
        },
        "sshManager.keepAliveInterval": {
          "type": "number",
          "default": 30,
          "minimum": 0
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:base": "node esbuild.config.mjs --variant=base",
    "copy:hub": "node scripts/copy-hub.mjs",
    "copy:policy-assets": "node scripts/copy-policy-assets.mjs",
    "build:mcp": "node esbuild.config.mjs --variant=mcp && npm run copy:hub && npm run copy:policy-assets",
    "package:base": "npm run build:base && node scripts/package-variant.mjs base",
    "package:mcp": "npm run build:mcp && node scripts/package-variant.mjs mcp"
  },
  "dependencies": {
    "@at-series/command-policy": "0.1.0",
    "@at-series/mcp-hub": "^0.3.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
